#!/bin/bash

set -e

# Hexarchy ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(hexarchy-default-agent) ]] && hexarchy-done ensure agent-setup-invitation; then
  hexarchy-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with Hexarchy." \
    --exec hexarchy menu summon setup.default.agent
fi
