#!/usr/bin/python3

# Hexcut: Hexarchy's own dead-simple video trimmer. The Hexarchy counterpart
# to Omacut (github.com/omacom-io/omacut) -- when all you need is to cut the
# start and end off a clip, this beats firing up a full video editor.

import json
import os
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk

APP_ID = "org.hexarchy.hexcut"


def ffprobe_duration(path):
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "json", path],
            capture_output=True, text=True, timeout=10, check=True,
        )
        return float(json.loads(out.stdout)["format"]["duration"])
    except (subprocess.SubprocessError, ValueError, KeyError, json.JSONDecodeError):
        return 0.0


def format_time(seconds):
    seconds = max(0, seconds)
    h = int(seconds // 3600)
    m = int((seconds % 3600) // 60)
    s = seconds % 60
    if h:
        return "%d:%02d:%05.2f" % (h, m, s)
    return "%d:%05.2f" % (m, s)


class HexcutWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Hexcut")
        self.set_default_size(520, 320)

        self.path = None
        self.duration = 0.0
        self.cut_proc = None

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="Hexcut", subtitle=""))
        self.header = header
        toolbar.add_top_bar(header)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        root.set_margin_start(20)
        root.set_margin_end(20)
        root.set_margin_top(16)
        root.set_margin_bottom(20)

        self.status = Adw.StatusPage(
            title="No video open",
            description="Pick a clip to trim the start and end off it.",
            icon_name="video-x-generic-symbolic",
        )
        open_btn = Gtk.Button(label="Open Video…")
        open_btn.add_css_class("suggested-action")
        open_btn.add_css_class("pill")
        open_btn.set_halign(Gtk.Align.CENTER)
        open_btn.connect("clicked", lambda _b: self.open_file())
        self.status.set_child(open_btn)

        self.editor = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)

        self.filename_label = Gtk.Label(xalign=0)
        self.filename_label.add_css_class("title-4")
        self.editor.append(self.filename_label)

        self.start_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 0.01)
        self.start_scale.set_hexpand(True)
        self.start_scale.set_draw_value(False)
        self.start_scale.connect("value-changed", self.on_start_changed)
        start_row = self.labeled_row("Start", self.start_scale)
        self.start_value = start_row[1]
        self.editor.append(start_row[0])

        self.end_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 0.01)
        self.end_scale.set_hexpand(True)
        self.end_scale.set_draw_value(False)
        self.end_scale.connect("value-changed", self.on_end_changed)
        end_row = self.labeled_row("End", self.end_scale)
        self.end_value = end_row[1]
        self.editor.append(end_row[0])

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_row.set_halign(Gtk.Align.END)
        preview_start_btn = Gtk.Button(label="Preview Start")
        preview_start_btn.connect("clicked", lambda _b: self.preview(self.start_scale.get_value()))
        preview_end_btn = Gtk.Button(label="Preview End")
        preview_end_btn.connect("clicked", lambda _b: self.preview(self.end_scale.get_value()))
        cut_btn = Gtk.Button(label="Cut")
        cut_btn.add_css_class("suggested-action")
        cut_btn.connect("clicked", lambda _b: self.cut())
        btn_row.append(preview_start_btn)
        btn_row.append(preview_end_btn)
        btn_row.append(cut_btn)
        self.editor.append(btn_row)

        self.stack = Gtk.Stack()
        self.stack.add_named(self.status, "empty")
        self.stack.add_named(self.editor, "editor")
        root.append(self.stack)

        toolbar.set_content(root)
        self.set_content(toolbar)

    def labeled_row(self, label_text, scale):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        label = Gtk.Label(label=label_text)
        label.set_width_chars(6)
        label.set_xalign(0)
        value = Gtk.Label(label="0:00.00")
        value.add_css_class("numeric")
        value.set_width_chars(10)
        row.append(label)
        row.append(scale)
        row.append(value)
        return row, value

    def open_file(self):
        dialog = Gtk.FileDialog(title="Open Video")
        video_filter = Gtk.FileFilter(name="Video")
        video_filter.add_mime_type("video/*")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(video_filter)
        dialog.set_filters(filters)

        def done(_dlg, result):
            try:
                gfile = dialog.open_finish(result)
            except GLib.Error:
                return
            if gfile:
                self.load(gfile.get_path())

        dialog.open(self, None, done)

    def load(self, path):
        self.path = path
        self.duration = ffprobe_duration(path)
        if self.duration <= 0:
            self.status.set_description("Couldn't read that file. Pick a different clip.")
            self.stack.set_visible_child_name("empty")
            return

        self.filename_label.set_text(os.path.basename(path))
        self.start_scale.set_range(0, self.duration)
        self.start_scale.set_value(0)
        self.end_scale.set_range(0, self.duration)
        self.end_scale.set_value(self.duration)
        self.stack.set_visible_child_name("editor")
        self.header.set_title_widget(Adw.WindowTitle(title="Hexcut", subtitle=os.path.basename(path)))

    def on_start_changed(self, scale):
        value = scale.get_value()
        if value > self.end_scale.get_value():
            scale.set_value(self.end_scale.get_value())
            return
        self.start_value.set_text(format_time(value))

    def on_end_changed(self, scale):
        value = scale.get_value()
        if value < self.start_scale.get_value():
            scale.set_value(self.start_scale.get_value())
            return
        self.end_value.set_text(format_time(value))

    def preview(self, position):
        if not self.path:
            return
        subprocess.Popen(
            ["mpv", "--start=%.3f" % position, self.path],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )

    def cut(self):
        if not self.path:
            return
        start = self.start_scale.get_value()
        end = self.end_scale.get_value()
        if end - start < 0.05:
            return

        base, ext = os.path.splitext(self.path)
        out_path = base + "-trimmed" + ext
        counter = 1
        while os.path.exists(out_path):
            out_path = "%s-trimmed-%d%s" % (base, counter, ext)
            counter += 1

        cmd = ["ffmpeg", "-y", "-i", self.path, "-ss", "%.3f" % start, "-to", "%.3f" % end, "-c", "copy", out_path]

        def run():
            result = subprocess.run(cmd, capture_output=True, text=True)
            GLib.idle_add(self.on_cut_done, result.returncode == 0, out_path, result.stderr[-800:])

        threading.Thread(target=run, daemon=True).start()

    def on_cut_done(self, ok, out_path, error_tail):
        dialog = Adw.AlertDialog(
            heading="Saved" if ok else "Cut failed",
            body=("Wrote " + out_path) if ok else error_tail,
        )
        dialog.add_response("ok", "OK")
        dialog.present(self)
        return False


class HexcutApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = HexcutWindow(self)
        win.present()


if __name__ == "__main__":
    sys.exit(HexcutApp().run(sys.argv))
