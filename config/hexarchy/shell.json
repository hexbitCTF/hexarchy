{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "hexarchy.clock",
    "layout": {
      "left": [
        {
          "id": "hexarchy.menu"
        },
        {
          "id": "hexarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "hexarchy.indicators"
        },
        {
          "id": "hexarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "hexarchy.keyboard-layout"
        },
        {
          "id": "hexarchy.weather"
        },
        {
          "id": "hexarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "hexarchy.tray"
        },
        {
          "id": "hexarchy.agents"
        },
        {
          "id": "hexarchy.bluetooth"
        },
        {
          "id": "hexarchy.network"
        },
        {
          "id": "hexarchy.audio"
        },
        {
          "id": "hexarchy.monitor"
        },
        {
          "id": "hexarchy.power"
        }
      ]
    }
  },
  "plugins": []
}
