#!/bin/bash

# hexarchy:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# hexarchy:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
hexarchy-pkg-add heroic-games-launcher-bin
hexarchy-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
