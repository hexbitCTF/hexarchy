#!/bin/bash

# hexarchy:summary=Check whether Tailscale is installed and running
# hexarchy:hidden=true

set -euo pipefail

if hexarchy-cmd-present tailscale && tailscale status --json >/dev/null 2>&1; then
  exit 0
fi

sv status tailscaled 2>/dev/null | grep -q running || pgrep -x tailscaled >/dev/null 2>&1
