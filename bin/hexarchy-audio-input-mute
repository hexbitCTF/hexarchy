#!/bin/bash

# hexarchy:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  hexarchy-brightness-keyboard-mute on
  hexarchy-osd -i microphone-muted -m "Microphone muted"
else
  hexarchy-brightness-keyboard-mute off
  hexarchy-osd -i microphone -m "Microphone on"
fi
