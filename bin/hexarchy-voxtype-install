#!/bin/bash

# hexarchy:summary=Install and configure Voxtype dictation
# hexarchy:requires-sudo=true

set -e

# Install voxtype and configure it for use.

if gum confirm "Install Voxtype + AI model (~150MB) to enable dictation?"; then
  hexarchy-pkg-add wtype voxtype-bin

  # Setup voxtype
  mkdir -p ~/.config/voxtype
  cp "$HEXARCHY_PATH/default/voxtype/config.toml" ~/.config/voxtype/

  voxtype setup --download --no-post-install
  if hexarchy-hw-vulkan; then
    voxtype setup gpu --enable || true
  fi

  hyprctl reload >/dev/null
  hexarchy-restart-shell
  hexarchy-notification-send -g  "Voxtype Dictation Ready" "Hold F9 to dictate (or toggle with Super + Ctrl + X)." -t 10000
fi
