#!/bin/bash

# hexarchy:summary=Log out after closing application windows
# hexarchy:examples=hexarchy logout | hexarchy system logout
# hexarchy:aliases=hexarchy logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

hexarchy-osd -i logout -m "Logging out" -d 5000

# Now close all windows
hexarchy-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
