#!/bin/bash

# hexarchy:summary=Print the directory holding a theme, preferring a user-installed copy
# hexarchy:args=<theme-name>
# hexarchy:examples=hexarchy theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: hexarchy-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/hexarchy/themes/$theme ]]; then
  echo "$HOME/.config/hexarchy/themes/$theme"
else
  echo "$HEXARCHY_PATH/themes/$theme"
fi
