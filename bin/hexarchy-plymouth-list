#!/bin/bash

# hexarchy:summary=List themes that can style the Plymouth boot screen
# hexarchy:examples=hexarchy plymouth list

{
  find ~/.config/hexarchy/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$HEXARCHY_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  if [[ -f $(hexarchy-theme-dir "$name")/preview-unlock.png ]]; then
    echo "$name"
  fi
done
