#!/bin/bash

# hexarchy:summary=Open the Hexarchy Discord community in the Discord app or a browser.

invite="https://discord.gg/tXFUdasqhY"

if hexarchy-cmd-present discord; then
  exec setsid uwsm-app -- discord --url -- "discord://-/invite/${invite##*/}"
else
  exec hexarchy-launch-webapp "$invite"
fi
