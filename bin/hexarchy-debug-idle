#!/bin/bash

# hexarchy:summary=Show idle, screensaver, and lock diagnostics
# hexarchy:group=debug
# hexarchy:args=[log-lines]
# hexarchy:examples=hexarchy debug idle | hexarchy-debug-idle 400

lines=${1:-200}
if [[ ! $lines =~ ^[0-9]+$ ]]; then
  lines=200
fi

section() {
  printf '\n== %s ==\n' "$1"
}

section "Time"
date -Is

section "Idle IPC status"
hexarchy-shell idle status 2>&1 | jq . 2>/dev/null || hexarchy-shell idle status 2>&1 || true

section "Quickshell instances"
quickshell list -p "$HEXARCHY_PATH/shell" --any-display 2>&1 || true

section "Recent idle logs"
quickshell --no-color log -p "$HEXARCHY_PATH/shell" --any-display --tail "$lines" --log-times -r 'quickshell.wayland.idle_notify=true' 2>&1 \
  | grep -Ei 'hexarchy idle|idle_notify|screensaver|lock|error|warn|failed' || true

section "Persisted shell log"
tail -n "$lines" "${XDG_STATE_HOME:-$HOME/.local/state}/hexarchy/shell.log" 2>/dev/null || true

section "Relevant processes"
ps -eo pid=,args= \
  | grep -E 'quickshell -n -p|hexarchy-system-sleep-monitor|loginctl inhibit.*Lock screen before suspend|org\.hexarchy\.screensaver|hexarchy-screensaver|(^|/| )ttfx( |$)' \
  | grep -v grep || true

section "Sleep lock service"
sv status hexarchy-sleep-lock 2>/dev/null || true

section "Hyprland screensaver clients"
hyprctl clients -j 2>/dev/null \
  | jq -r '.[] | select(.class == "org.hexarchy.screensaver" or .initialClass == "org.hexarchy.screensaver") | [.pid,.class,.initialClass,.title,.focusHistoryID] | @tsv' || true

section "Idle inhibitors"
hyprctl clients -j 2>/dev/null \
  | jq -r '.[] | select(.inhibitingIdle == true or ((.tags // []) | index("noidle"))) | [.pid,.class,.title,((.tags // []) | join(",")),.inhibitingIdle] | @tsv' || true

section "Screensaver detector"
if hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "org.hexarchy.screensaver" or .initialClass == "org.hexarchy.screensaver")' >/dev/null; then
  echo "running-window"
elif pgrep -f '[o]rg.hexarchy.screensaver' >/dev/null; then
  echo "running-process"
elif hexarchy-toggle-enabled screensaver-off; then
  echo "disabled"
else
  echo "stopped"
fi

section "Lock detector"
hexarchy-shell lock status 2>&1 | jq . 2>/dev/null || hexarchy-shell lock status 2>&1 || true
