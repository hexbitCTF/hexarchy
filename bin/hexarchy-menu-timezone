#!/bin/bash

# hexarchy:summary=Select and set the system timezone
# hexarchy:group=menu
# hexarchy:name=timezone

set -e

timezone=$(timedatectl list-timezones | hexarchy-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
hexarchy-shell -q hexarchy.clock refresh
hexarchy-notification-send "Timezone is now set to $timezone"
