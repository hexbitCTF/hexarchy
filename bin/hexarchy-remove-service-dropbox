#!/bin/bash

# hexarchy:summary=Remove Dropbox and its bar plugin.
# hexarchy:requires-sudo=true

dropbox-cli stop 2>/dev/null || true
hexarchy-plugin-disable hexarchy.dropbox
hexarchy-pkg-drop dropbox dropbox-cli libappindicator-gtk3 python-gpgme nautilus-dropbox

echo ""
echo "Dropbox has been removed."
