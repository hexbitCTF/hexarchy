#!/bin/bash

# hexarchy:summary=Send the low battery warning notification and run battery-low hooks.
# hexarchy:args=<percentage>
# hexarchy:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: hexarchy-battery-low <percentage>" >&2
  exit 1
fi

level=$1

hexarchy-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
hexarchy-hook battery-low "$level"
