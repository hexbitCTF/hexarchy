#!/bin/bash

# hexarchy:summary=Manage persistent state files for Hexarchy toggles and settings.
# hexarchy:args=<set|clear> <state-name-or-pattern>
# hexarchy:hidden=true

STATE_DIR="$HOME/.local/state/hexarchy"
mkdir -p "$STATE_DIR"

COMMAND="$1"
STATE_NAME="$2"

if [[ -z $COMMAND ]]; then
  echo "Usage: hexarchy-state <set|clear> <state-name-or-pattern>"
  exit 1
fi

if [[ -z $STATE_NAME ]]; then
  echo "Usage: hexarchy-state $COMMAND <state-name>"
  exit 1
fi

case "$COMMAND" in
set) touch "$STATE_DIR/$STATE_NAME" ;;
clear) find "$STATE_DIR" -maxdepth 1 -type f -name "$STATE_NAME" -delete ;;
esac
