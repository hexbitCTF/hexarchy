#!/bin/bash

# hexarchy:summary=Reset Hexarchy user configs and shipped defaults in $HOME (destructive)

set -euo pipefail

if (( EUID == 0 )); then
  echo "Error: This script should not be run as root"
  exit 1
fi

echo "Resetting Hexarchy user configs to shipped defaults..."

# /etc/skel is the same tree useradd -m copies to seed a fresh user's $HOME.
# Replaying it over an existing user resyncs every package-shipped user
# default in one pass: .bashrc, .config/**, .local/share/applications,
# nautilus-python extensions, branding, hypr toggles, and migration markers.
# Trailing dot copies dotfiles; the shell wouldn't glob them with /etc/skel/*.
cp -af /etc/skel/. ~/

hexarchy-refresh-limine
hexarchy-refresh-plymouth

if hexarchy-cmd-present hexarchy-nvim-refresh; then
  hexarchy-nvim-refresh
elif hexarchy-cmd-present hexarchy-nvim-setup; then
  hexarchy-nvim-setup --force
fi
