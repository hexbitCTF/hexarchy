#!/bin/bash

# hexarchy:summary=Show which theme is styling the Plymouth boot screen
# hexarchy:examples=hexarchy plymouth current

# hexarchy-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/hexarchy/logo.png

if cmp -s "$HEXARCHY_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

hexarchy-plymouth-list | while read -r name; do
  if cmp -s "$(hexarchy-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
