#!/bin/bash

# hexarchy:summary=Reinstall all default Hexarchy packages from the stable channel
# hexarchy:requires-sudo=true

set -e

# Reinstall all default Hexarchy packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
hexarchy-refresh-pacman

# Downgrade any packages to the stable setup
sudo env HEXARCHY_UPDATE_PACMAN=1 pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$HEXARCHY_PATH/install/hexarchy-base.packages" | grep -v '^$')
sudo env HEXARCHY_UPDATE_PACMAN=1 pacman -Syu --noconfirm --needed "${packages[@]}"
