#!/bin/bash

# hexarchy:summary=Remove the GeForce NOW Flatpak app and its data.
# hexarchy:group=remove
# hexarchy:name=gaming geforce-now

set -e

if hexarchy-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
