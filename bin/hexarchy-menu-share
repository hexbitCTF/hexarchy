#!/bin/bash

# hexarchy:summary=Share clipboard, files, or folders with LocalSend
# hexarchy:group=share
# hexarchy:name=
# hexarchy:args=<clipboard|file|folder> [path...]
# hexarchy:examples=hexarchy share clipboard | hexarchy share file ~/Downloads/example.txt

if (($# == 0)); then
  echo "Usage: hexarchy-menu-share [clipboard|file|folder]"
  exit 1
fi

MODE="$1"
shift

if [[ $MODE == "clipboard" ]]; then
  TEMP_FILE=$(mktemp --suffix=.txt)
  wl-paste >"$TEMP_FILE"
  FILE_ARRAY=("$TEMP_FILE")
elif (($# > 0)); then
  FILE_ARRAY=("$@")
else
  if [[ $MODE == "folder" ]]; then
    select_args=(--title "Share folder" --directory)
  else
    select_args=(--title "Share files" --multiple)
  fi

  # Command substitution so the chooser's exit status survives: reading it
  # through a process substitution reports success for a chooser that never
  # opened, which is indistinguishable here from someone deciding not to share.
  picked=$(hexarchy-file-select "${select_args[@]}") || status=$?

  if ((${status:-0} > 1)); then
    hexarchy-notification-send -g "" -u critical "Could not share" "The file chooser did not open"
    exit 1
  fi

  [[ -n $picked ]] || exit 0
  readarray -t FILE_ARRAY <<<"$picked"
fi

# Run LocalSend detached from terminal
nohup localsend --headless send "${FILE_ARRAY[@]}" >/dev/null 2>&1 &

# Note: Temporary file will remain until system cleanup for clipboard mode
# This ensures the file content is available for the LocalSend GUI

exit 0
