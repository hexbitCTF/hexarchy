#!/bin/bash

# hexarchy:summary=Apply theme colors to cava config
# hexarchy:hidden=true

CAVA_CONFIG="$HOME/.config/cava/config"
CURRENT_THEME="$HOME/.local/state/hexarchy/current/theme"

[[ -f "$CURRENT_THEME/cava.config" ]] || exit 0

mkdir -p "$(dirname "$CAVA_CONFIG")"
cp "$CURRENT_THEME/cava.config" "$CAVA_CONFIG"
