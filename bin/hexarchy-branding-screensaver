#!/bin/bash

# hexarchy:summary=Edit, set, or reset screensaver branding
# hexarchy:group=branding
# hexarchy:name=screensaver
# hexarchy:args=<image|text|reset>
# hexarchy:examples=hexarchy branding screensaver image | hexarchy branding screensaver text | hexarchy branding screensaver reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(hexarchy-file-select --title "Pick PNG or SVG for screensaver" --extensions "png svg")
  if hexarchy-transcode-ascii "$image" ~/.config/hexarchy/branding/screensaver.txt; then
    hexarchy-launch-screensaver force >/dev/null 2>&1
  fi
  ;;
text)
  hexarchy-launch-editor ~/.config/hexarchy/branding/screensaver.txt >/dev/null 2>&1 && hexarchy-launch-screensaver force >/dev/null 2>&1
  ;;
reset)
  cp "$HEXARCHY_PATH/logo.txt" ~/.config/hexarchy/branding/screensaver.txt && hexarchy-launch-screensaver force >/dev/null 2>&1
  ;;
*)
  echo "Usage: hexarchy-branding-screensaver <image|text|reset>" >&2
  exit 1
  ;;
esac
