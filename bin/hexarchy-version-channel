#!/bin/bash

# hexarchy:summary=Print the active Hexarchy mirror and package channel

if grep -q "https://stable-mirror.hexarchy.org/" /etc/pacman.d/mirrorlist; then
  mirror="stable"
elif grep -q "https://rc-mirror.hexarchy.org/" /etc/pacman.d/mirrorlist; then
  mirror="rc"
elif grep -q "https://mirror.hexarchy.org/" /etc/pacman.d/mirrorlist; then
  mirror="edge"
else
  mirror="unknown"
fi

if grep -q "https://pkgs.hexarchy.org/stable/" /etc/pacman.conf; then
  pkgs="stable"
elif grep -q "https://pkgs.hexarchy.org/edge/" /etc/pacman.conf; then
  pkgs="edge"
else
  pkgs="unknown"
fi

if [[ $mirror == $pkgs ]]; then
  echo $mirror
else
  echo "$mirror / $pkgs"
fi
