#!/bin/bash

# hexarchy:summary=Remove Ollama along with every model it pulled.
# hexarchy:requires-sudo=true

set -e

# The service is what holds the models open, so it goes before the package.
sudo sv stop ollama 2>/dev/null || true
sudo rm -f /run/runit/service/ollama 2>/dev/null || true

# Whichever acceleration variant is installed provides the same command.
hexarchy-pkg-drop ollama ollama-cuda ollama-rocm ollama-vulkan

sudo rm -rf /var/lib/ollama
rm -rf "$HOME/.ollama"

echo ""
echo "Ollama and its models have been removed."
