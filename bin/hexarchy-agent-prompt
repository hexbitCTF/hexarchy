#!/bin/bash

# hexarchy:summary=Launch the default coding agent with a prompt
# hexarchy:args=[--inline] <prompt...>
# hexarchy:examples=hexarchy agent prompt "Review this project"

# Prompts live here rather than on `hexarchy agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: hexarchy agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec hexarchy-agent "${inline[@]}" --prompt "$*"
