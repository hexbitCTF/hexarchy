#!/bin/bash

# hexarchy:summary=Install a packaged app, surfacing the install in a floating terminal
# hexarchy:args=<display-name> <packages>
# hexarchy:examples=hexarchy install app 'LM Studio' lmstudio-bin

name="${1-}"
packages="${2-}"

if [[ -z $name || -z $packages ]]; then
  echo "Usage: hexarchy-install-app <display-name> <packages>" >&2
  exit 1
fi

exec hexarchy-launch-floating-terminal-with-presentation "echo 'Installing ${name}...'; hexarchy-pkg-add ${packages}"
