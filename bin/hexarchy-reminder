#!/bin/bash

# hexarchy:summary=Set and show lightweight desktop notification reminders
# hexarchy:args=[-i|--interactive] | <minutes> [message] | show [-j|--json] | clear
# hexarchy:examples=hexarchy reminder -i | hexarchy reminder 5 | hexarchy reminder 30 "Check the oven" | hexarchy reminder show | hexarchy reminder show --json | hexarchy reminder clear

set -euo pipefail

format_remaining() {
  local seconds=$1
  local minutes=$((seconds / 60))
  local remainder=$((seconds % 60))

  if ((minutes > 0 && remainder > 0)); then
    echo "${minutes}m ${remainder}s"
  elif ((minutes > 0)); then
    echo "${minutes}m"
  else
    echo "${remainder}s"
  fi
}

active_reminder_timers() {
  local now=${1:-$(date +%s)}
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/hexarchy-reminders"
  local unit next

  for next_file in "$reminder_dir"/*.next; do
    [[ -f $next_file ]] || continue
    next=$(<"$next_file")
    [[ -n $next ]] || continue
    unit=${next_file##*/}
    unit=${unit%.next}

    ((next <= now)) && continue

    printf "%s\t%s\n" "$unit" "$next"
  done
}

refresh_indicator() {
  hexarchy-shell -q hexarchy.indicators refresh >/dev/null 2>&1 || true
}

open_interactive() {
  hexarchy-shell shell summon hexarchy.reminders "{}"
}

show_reminders() {
  local timer next remaining reminder reminder_minutes body=""
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/hexarchy-reminders"
  local reminder_message=""
  local now=$(date +%s)

  while IFS=$'\t' read -r timer next; do
    remaining=$((next - now))
    reminder=${timer%.timer}
    reminder=${reminder#hexarchy-reminder-}
    reminder_minutes=${reminder%%m-*}
    reminder_message=""
    [[ -f $reminder_dir/${timer%.timer}.message ]] && reminder_message=$(<"$reminder_dir/${timer%.timer}.message")

    if [[ -n $reminder_message ]]; then
      body+="$reminder_message in $(format_remaining $remaining) ($(date -d "@$next" +%-H:%M))"$'\n'
    else
      body+="${reminder_minutes}-min reminder in $(format_remaining $remaining) ($(date -d "@$next" +%-H:%M))"$'\n'
    fi
  done < <(active_reminder_timers "$now")

  if [[ -z $body ]]; then
    hexarchy-notification-send -g 󰢌 "Upcoming reminders" "No outstanding reminders"
  else
    hexarchy-notification-send -g 󰢌 "Upcoming reminders" "${body%$'\n'}"
  fi
}

show_json() {
  local timer next remaining reminder reminder_minutes unit reminder_message label item_json reminders_json="[]"
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/hexarchy-reminders"
  local now=$(date +%s)
  local count=0
  local tooltip="Set Reminder"

  while IFS=$'\t' read -r timer next; do
    count=$((count + 1))

    unit=${timer%.timer}
    reminder=${unit#hexarchy-reminder-}
    reminder_minutes=${reminder%%m-*}
    [[ ! $reminder_minutes =~ ^[0-9]+$ ]] && reminder_minutes=0
    remaining=$((next - now))
    reminder_message=""
    [[ -f $reminder_dir/$unit.message ]] && reminder_message=$(<"$reminder_dir/$unit.message")

    if [[ -n $reminder_message ]]; then
      label=$reminder_message
    else
      label="${reminder_minutes}-min reminder"
    fi

    item_json=$(jq -cn \
      --arg unit "$unit" \
      --arg timer "$timer" \
      --arg label "$label" \
      --arg message "$reminder_message" \
      --arg remaining "$(format_remaining "$remaining")" \
      --arg atTime "$(date -d "@$next" +%-H:%M)" \
      --argjson minutes "$reminder_minutes" \
      --argjson at "$next" \
      --argjson remainingSeconds "$remaining" \
      '{unit:$unit,timer:$timer,minutes:$minutes,message:$message,label:$label,remaining:$remaining,remainingSeconds:$remainingSeconds,at:$at,atTime:$atTime}')
    reminders_json=$(jq -cn --argjson reminders "$reminders_json" --argjson item "$item_json" '$reminders + [$item]')
  done < <(active_reminder_timers "$now")

  if ((count == 1)); then
    tooltip="1 reminder"
  elif ((count > 1)); then
    tooltip="$count reminders"
  fi

  jq -cn --argjson count "$count" --arg tooltip "$tooltip" --argjson reminders "$reminders_json" '{count:$count,active:($count > 0),tooltip:$tooltip,reminders:$reminders}'
}

clear_reminders() {
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/hexarchy-reminders"
  local next_file unit

  for next_file in "$reminder_dir"/*.next; do
    [[ -f $next_file ]] || continue
    unit=${next_file##*/}
    unit=${unit%.next}
    rm -f "$reminder_dir/$unit.next" "$reminder_dir/$unit.pid" 2>/dev/null || true
    kill "$(cat "$reminder_dir/$unit.pid" 2>/dev/null)" 2>/dev/null || true
    rm -f "$reminder_dir/$unit.pid" 2>/dev/null || true
  done

  rm -f "$reminder_dir"/hexarchy-reminder-*.message 2>/dev/null || true
  refresh_indicator
  hexarchy-notification-send -g 󰢌 "All reminders have been cleared"
}

usage() {
  echo "Usage: hexarchy-reminder [-i|--interactive]"
  echo "       hexarchy-reminder <minutes> [message]"
  echo "       hexarchy-reminder show [-j|--json]"
  echo "       hexarchy-reminder clear"
}

case ${1:-} in
-i | --interactive)
  open_interactive
  exit 0
  ;;
show | list)
  case ${2:-} in
  -j | --json)
    show_json
    ;;
  "")
    show_reminders
    ;;
  *)
    usage
    exit 1
    ;;
  esac
  exit 0
  ;;
clear)
  clear_reminders
  exit 0
  ;;
esac

minutes=${1:-}
shift || true
message="$*"
custom_message="$message"

if [[ -z $minutes ]] || [[ ! $minutes =~ ^[0-9]+$ ]] || ((minutes == 0)); then
  usage
  exit 1
fi

if [[ -z $message ]]; then
  message="Your ${minutes} minutes are up"
fi

set_at=$(date +%s)
remind_at=$(date -d "+${minutes} minutes" +%H:%M)
unit="hexarchy-reminder-${minutes}m-$set_at"
reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/hexarchy-reminders"
message_file="$reminder_dir/$unit.message"
confirmation="You'll be reminded at $remind_at"
confirmation_title="Reminder set for ${minutes} minutes"

mkdir -p "$reminder_dir"

if [[ -n $custom_message ]]; then
  printf "%s" "$custom_message" >"$message_file"
  confirmation_title="$custom_message in ${minutes} minutes"
fi

# Store the next-fire timestamp and launch a background sleeper.
printf '%s' "$(( $(date +%s) + minutes * 60 ))" >"$reminder_dir/$unit.next"
( sleep "${minutes}m"; rm -f "$reminder_dir/$unit.next"; \
  hexarchy-notification-send -g 󰢌 "Reminder" "$message"; rm -f "$message_file"; \
  hexarchy-shell -q hexarchy.indicators refresh >/dev/null 2>&1 || true ) &
printf '%s' "$!" >"$reminder_dir/$unit.pid"

refresh_indicator
hexarchy-notification-send -g 󰢌 "$confirmation_title" "$confirmation"
