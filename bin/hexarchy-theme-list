#!/bin/bash

# hexarchy:summary=List available themes
# hexarchy:examples=hexarchy theme list | hexarchy theme set "Tokyo Night"

{
  find ~/.config/hexarchy/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$HEXARCHY_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
