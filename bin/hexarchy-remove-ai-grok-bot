#!/bin/bash

# hexarchy:summary=Remove Grok Bot along with its settings and data.
# hexarchy:requires-sudo=true

set -e

hexarchy-pkg-drop grok-bot

# Not ~/.grok: that is the Grok CLI, which is installed and used on its own.
rm -rf \
  "$HOME/.config/Grok Bot" \
  "$HOME/.grokbot"

echo ""
echo "Grok Bot has been removed."
