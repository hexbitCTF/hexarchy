#!/bin/bash

# hexarchy:summary=Install the Hexarchy live-theme Firefox extension and its native messaging host
# hexarchy:args=[profile-dir]

set -euo pipefail

HOST_NAME="com.hexarchy.firefox_theme"
EXTENSION_ID="hexarchy-theme@hexarchy.org"
SOURCE_DIR="$HEXARCHY_PATH/default/firefox/theme-extension"
EXTENSION_DIR="$HOME/.local/share/hexarchy/firefox-theme"
HOST_PATH="$HOME/.local/bin/hexarchy-firefox-theme-host"
XPI_PATH="$EXTENSION_DIR/$EXTENSION_ID.xpi"

PROFILE_BASE="$HOME/.config/mozilla/firefox"

build_xpi() {
  local tmp

  tmp=$(mktemp -d)
  trap 'rm -rf "${tmp:-}"' EXIT

  mkdir -p "$EXTENSION_DIR"
  cp "$SOURCE_DIR/manifest.json" "$tmp/"
  cp "$SOURCE_DIR/background.js" "$tmp/"

  python3 - "$tmp" "$XPI_PATH" <<'PY'
import sys, zipfile

src, xpi = sys.argv[1:3]
with zipfile.ZipFile(xpi, "w", zipfile.ZIP_DEFLATED) as z:
    for name in ("manifest.json", "background.js"):
        z.write(f"{src}/{name}", name)
PY
}

install_native_manifest() {
  local manifest

  manifest=$(jq -cn \
    --arg name "$HOST_NAME" \
    --arg path "$HOST_PATH" \
    '{name: $name, description: "Hexarchy Firefox theme sync", path: $path, type: "stdio", allowed_extensions: ["hexarchy-theme@hexarchy.org"]}')

  for dir in \
    "$HOME/.mozilla/native-messaging-hosts" \
    "$HOME/.config/mozilla/native-messaging-hosts" \
    "$PROFILE_BASE/native-messaging-hosts"; do
    mkdir -p "$dir"
    printf '%s\n' "$manifest" >"$dir/$HOST_NAME.json"
  done
}

install_profile_addon() {
  local profile="${1:-}"

  if [[ -n $profile ]]; then
    install_profile_addon_into "$profile"
    return
  fi

  local path
  while IFS= read -r path; do
    [[ -n $path ]] || continue
    install_profile_addon_into "$path"
  done < <(awk -F= '/^Path=/{print $2}' "$PROFILE_BASE/profiles.ini" 2>/dev/null || true)
}

install_profile_addon_into() {
  local profile="$1"
  local dir

  dir="$PROFILE_BASE/$profile"
  [[ -d $dir ]] || dir="$HOME/$profile"
  [[ -d $dir ]] || { echo "  skip: profile dir not found: $profile"; return; }

  mkdir -p "$dir/extensions"
  cp -f "$XPI_PATH" "$dir/extensions/$EXTENSION_ID.xpi"
  echo "  installed: $dir/extensions/$EXTENSION_ID.xpi"
}

build_xpi
install_native_manifest
install_profile_addon "${1:-}"

echo "Hexarchy Firefox live theme installed."
echo "Restart Firefox to pick up the extension."
