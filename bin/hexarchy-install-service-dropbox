#!/bin/bash

# hexarchy:summary=Install and start the Dropbox service. Must then be authenticated via the web.

echo "Installing all dependencies..."
hexarchy-pkg-add dropbox dropbox-cli libappindicator-gtk3 python-gpgme nautilus-dropbox

echo "Adding Dropbox to the bar..."
hexarchy-plugin-enable hexarchy.dropbox

echo "Starting Dropbox..."
uwsm-app -- dropbox-cli start &>/dev/null &
echo "See Dropbox icon behind  hover tray in top right and right-click for setup."
