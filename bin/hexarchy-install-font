#!/bin/bash

# hexarchy:summary=Install a Nerd Font package and switch the system to it
# hexarchy:args=<display-name> <package> <family>
# hexarchy:examples=hexarchy install font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'

name="${1-}"
package="${2-}"
family="${3-}"

if [[ -z $name || -z $package || -z $family ]]; then
  echo "Usage: hexarchy-install-font <display-name> <package> <family>" >&2
  exit 1
fi

exec hexarchy-launch-floating-terminal-with-presentation \
  "echo 'Installing ${name}...'; hexarchy-pkg-add ${package} && sleep 2 && hexarchy-font-set '${family}'"
