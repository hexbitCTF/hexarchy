#!/bin/bash

# hexarchy:summary=Launch a TUI or focus an existing terminal window for it
# hexarchy:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.hexarchy.$(basename "$1")"
fi

LAUNCH_COMMAND="hexarchy-launch-tui $@"

exec hexarchy-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
