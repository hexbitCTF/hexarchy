# Single source of truth for HEXARCHY_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/hexarchy.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-hexarchy          (Hyprland session via uwsm)
#   /usr/share/hexarchy/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/hexarchy.conf is written by hexarchy-dev-link and reset by
# hexarchy-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/hexarchy.conf ]; then
  . /etc/hexarchy.conf
  : "${HEXARCHY_PATH:=/usr/share/hexarchy}"
else
  HEXARCHY_PATH=/usr/share/hexarchy
fi
export HEXARCHY_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/hexarchy-* via the hexarchy package — prepending
# /usr/share/hexarchy/bin would just be noise.
if [ "$HEXARCHY_PATH" != /usr/share/hexarchy ]; then
  case ":$PATH:" in
    *":${HEXARCHY_PATH%/}/bin:"*) ;;
    *) PATH="${HEXARCHY_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
