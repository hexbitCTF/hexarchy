#!/bin/bash
# WhatsApp web app launcher.
#
# First checks for an already-open WhatsApp window and just focuses it -
# Firefox's --kiosk mode always cold-starts a brand new browser process
# (it can't share a running instance the way a normal new window/tab can),
# so re-launching every click would mean paying that startup cost every
# time. Focusing an existing window is instant; only a genuinely fresh
# launch pays the cold-start cost.
WINDOW_ADDRESS=$(hyprctl clients -j | jq -r '.[]|select(.class=="firefox-dev" and (.title|test("^WhatsApp")))|.address' | head -n1)

if [[ -n $WINDOW_ADDRESS ]]; then
  exec hyprctl dispatch "hl.dsp.focus({ window = \"address:$WINDOW_ADDRESS\" })"
fi

# Fresh launch: use Hyprland's exec_cmd dispatcher, which attaches a window
# rule to the exact process it spawns (matched by PID) - no title/class
# matching race, so the rule is active before Firefox's kiosk mode ever
# requests fullscreen (no flash).
#
# fullscreen_state = "0 2" decouples what Hyprland does from what Firefox is
# told: internal=0 keeps the window tiled with normal gaps, client=2 tells
# Firefox it IS fullscreen so kiosk mode keeps its chrome hidden.
# (suppress_event=fullscreen alone just blocks the request outright, which
# left Firefox thinking it failed and re-showing its toolbar.)
#
# --profile points this at a dedicated profile instead of the default one.
# Firefox's kiosk mode and single-instance remoting are both whole-process
# (really whole-profile) settings, not per-window - sharing the default
# profile meant any other Firefox window you opened could get folded into
# this same kiosk-mode process and lose its toolbar/go fullscreen too. A
# separate profile makes this app's process (and its remoting) completely
# independent from your regular Firefox, permanently. Costs one QR re-scan
# the first time only; the profile stays logged in after that.
#
# The Firefox binary is resolved rather than hardcoded, because the layouts
# differ between machines. Order matters: prefer the `firefox` wrapper over
# `firefox-bin` in every install directory. The wrapper handles first-run
# profile creation and then execs the real binary, whereas firefox-bin only
# attaches to a profile that already exists and exits with
# "Could not find profile folder" otherwise. This launcher is the first thing
# to touch the dedicated WhatsApp profile, so it has to be the wrapper.
#
# A note on false success: this dispatches through `hyprctl dispatch`, which
# prints "ok" and exits 0 as soon as it accepts the request. That says nothing
# about whether the process it spawned survived, so exit 0 here is not evidence
# that a window opened.
firefox_bin=""
for candidate in \
  /opt/firefox-developer-edition/firefox \
  /opt/firefox-dev/firefox \
  /opt/firefox-dev/firefox-bin; do
  if [[ -x $candidate ]]; then
    firefox_bin="$candidate"
    break
  fi
done

if [[ -z $firefox_bin ]]; then
  firefox_bin="$(command -v firefox-dev || true)"
fi

if [[ -z $firefox_bin || ! -x $firefox_bin ]]; then
  echo "Firefox Developer Edition not found (looked for /opt/firefox-developer-edition/firefox, /opt/firefox-dev/firefox, and firefox-dev on PATH)." >&2
  exit 1
fi

echo "whatsapp-webapp-launch: using $firefox_bin" >&2

# The dedicated profile lives inside whichever root this machine's Firefox
# actually uses -- ~/.mozilla/firefox by default, or ~/.config/mozilla/firefox
# when something relocated it under XDG. Keeping it under the real root matters
# for two reasons: the theme-set hooks enumerate profiles through that root's
# profiles.ini, so a profile parked outside it never gets the Hexarchy theme,
# and Firefox only discovers profiles it knows about.
PROFILE_BASE=""
for candidate in "$HOME/.mozilla/firefox" "$HOME/.config/mozilla/firefox"; do
  if [[ -f "$candidate/profiles.ini" ]]; then
    PROFILE_BASE="$candidate"
    break
  fi
done

if [[ -z $PROFILE_BASE ]]; then
  echo "No Firefox profiles.ini in ~/.mozilla/firefox or ~/.config/mozilla/firefox." >&2
  echo "Launch Firefox once so it creates a profile, then re-run this." >&2
  exit 1
fi

profile_name="whatsapp-app"
profile_dir="$PROFILE_BASE/$profile_name"

# --profile against a path that does not exist is a hard error in both the
# firefox wrapper and firefox-bin ("Could not find profile folder"), and
# -CreateProfile is a no-op on these builds. An existing empty directory is
# enough: Firefox initialises a full profile into it on first launch.
mkdir -p "$profile_dir" || {
  echo "whatsapp-webapp-launch: could not create $profile_dir" >&2
  exit 1
}

# Register it so Firefox and the theme hooks can see it. Idempotent.
# Deliberately no Default=1 here: the machine's real profile already claims
# default, and two profiles both marked default makes Firefox resolve which one
# a plain launch uses unpredictably. This one is reachable by --profile only.
if ! grep -q "^Path=$profile_name$" "$PROFILE_BASE/profiles.ini" 2>/dev/null; then
  {
    echo ""
    echo "[Profile$profile_name]"
    echo "Name=whatsapp-app"
    echo "IsRelative=1"
    echo "Path=$profile_name"
  } >>"$PROFILE_BASE/profiles.ini"
  echo "whatsapp-webapp-launch: registered profile $profile_name in $PROFILE_BASE/profiles.ini" >&2
fi

exec hyprctl dispatch "hl.dsp.exec_cmd(\"setsid uwsm-app -- $firefox_bin --profile $profile_dir --kiosk --new-window https://web.whatsapp.com\", { fullscreen_state = \"0 2\" })"
