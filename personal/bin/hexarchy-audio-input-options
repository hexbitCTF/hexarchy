#!/bin/bash
# Print the selectable microphone options for the audio panel, one per line:
#   <id>	<name>	<label>	<available>	<active>
#
# The panel's input always runs through the mic noise gate (noise_gate_source);
# these options select which raw ALSA mic feeds the gate:
#   hexbit.input.laptop  - Mic1 (internal "Digital Microphone")
#   hexbit.input.headset - Mic2 (headset "Stereo Microphone"), only while the
#                          jack actually has the headset mic present
#
# The active feed follows the lock written by hexarchy-audio-input-toggle; with
# no lock it follows the jack (headset mic when available, else laptop mic).

state="${XDG_STATE_HOME:-$HOME/.local/state}/hexarchy"
lockfile="$state/audio-input-lock"
micprefix="alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic"
mic2="$micprefix.HiFi__Mic2__source"

mic2_avail() {
	pactl list sources 2>/dev/null | awk -v n="$mic2" '
		$0 == ("Name: " n) { in_node = 1 }
		in_node && /Ports:/ { in_ports = 1 }
		in_node && in_ports && /\[In\]/ {
			print (index($0, "not available") ? 0 : 1)
			exit
		}
	'
}

available="$(mic2_avail)"
available="${available:-0}"

lock="$(cat "$lockfile" 2>/dev/null)"

# Effective active feed: an explicit lock wins while its mic is usable;
# otherwise follow the jack.
if [ "$lock" = "mic2" ] && [ "$available" = "1" ]; then
	active="mic2"
elif [ "$lock" = "mic1" ]; then
	active="mic1"
elif [ "$available" = "1" ]; then
	active="mic2"
else
	active="mic1"
fi

if [ "$active" = "mic1" ]; then
	printf -- "-800000001\thexbit.input.laptop\tLaptop Microphone\t1\t1\n"
else
	printf -- "-800000001\thexbit.input.laptop\tLaptop Microphone\t1\t0\n"
fi

if [ "$available" = "1" ]; then
	if [ "$active" = "mic2" ]; then
		printf -- "-800000002\thexbit.input.headset\tHeadset Microphone\t1\t1\n"
	else
		printf -- "-800000002\thexbit.input.headset\tHeadset Microphone\t1\t0\n"
	fi
fi

exit 0