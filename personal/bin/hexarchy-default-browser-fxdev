#!/bin/bash

# Set Firefox Developer Edition as the default browser for Hexarchy and XDG
# scheme handlers. Mirrors hexarchy-default-browser but wired to a
# firefox-developer-edition install.
#
# The desktop entry name is not the same everywhere: a tarball install ships
# firefox-developer-edition.desktop, a distro package or a /opt/firefox-dev
# layout ships firefox-dev.desktop. Look for whichever one is actually
# installed rather than assuming, so this works on more than one machine.

browser="firefox-dev"
command="firefox-dev"
name="Firefox Developer Edition"
glyph=󰈹

desktop_id=""
for candidate in firefox-developer-edition.desktop firefox-dev.desktop firefox.desktop; do
  if [[ -e "/usr/share/applications/$candidate" || -e "$HOME/.local/share/applications/$candidate" ]]; then
    desktop_id="$candidate"
    break
  fi
done

if [[ -z $desktop_id ]]; then
  echo "No Firefox desktop entry found in /usr/share/applications." >&2
  exit 1
fi

schemes=(
  x-scheme-handler/http
  x-scheme-handler/https
  x-scheme-handler/ftp
  x-scheme-handler/about
)

env -u BROWSER xdg-settings set default-web-browser "$desktop_id" || exit 1

for scheme in "${schemes[@]}"; do
  xdg-mime default "$desktop_id" "$scheme"
done

# Best-effort: on a systemd-free host the notifier needs a user bus that does
# not exist, and the desktop entry is already set by this point, so a failed
# toast must not make the command look like it failed.
hexarchy-notification-send -g $glyph "$name ($desktop_id) is now the default browser" >/dev/null 2>&1 || true
