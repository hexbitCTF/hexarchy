#!/bin/bash
# Print the laptop's currently-inactive analog output as "<sink-name>\t<label>"
# so the audio panel can offer a manual Speaker <-> Headphones toggle row.
# Emits nothing when the active ACP profile selects neither analog output,
# and only once the headphone jack actually senses a plug -- otherwise a
# phantom "Earphones" entry would sit in the output list with nothing in the
# jack.

card="alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic"
prefix="alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic"

active="$(pactl list cards 2>/dev/null | awk '
	$1 == "Name:" && $2 == c { want = 1; next }
	want && /Active Profile:/ { sub(/.*Active Profile: /, ""); print; exit }
' c="$card")"

# The Headphones port is only usable while something is in the jack; keep the
# toggle row out of the output list until then.
hp_plugged="$(pactl list cards 2>/dev/null | awk '
	$1 == "Name:" && $2 == c { want = 1; next }
	want && /\[Out\] Headphones:/ { print (index($0, "not available") ? 0 : 1); exit }
' c="$card")"
[ "$hp_plugged" = "1" ] || exit 0

case "$active" in
	*"Headphones"*) printf "%s\t%s\n" "$prefix.HiFi__Speaker__sink" "Laptop Speakers" ;;
	*"Speaker"*)    printf "%s\t%s\n" "$prefix.HiFi__Headphones__sink" "Earphones" ;;
esac

exit 0