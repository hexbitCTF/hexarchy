#!/bin/bash
# Wire the best-available microphone through the mic-noise-gate filter-chain
# client and keep the gated source as the default input.
#
# Persistent loop (started from ~/.config/hypr/autostart.lua). PipeWire links
# are not persisted by the daemon, and the active mic must follow the jack:
#   - headset plugged   -> Mic2 (external "Stereo Microphone") is the input
#   - nothing plugged   -> Mic1 (internal "Digital Microphone") is the input
# so that apps recording from noise_gate_source always get the live mic and
# the noise gate applied to it.

gate_in="capture.noise_gate:playback_FL"
gate_out="noise_gate_source"
micprefix="alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic"
state="${XDG_STATE_HOME:-$HOME/.local/state}/hexarchy"
lockfile="$state/audio-input-lock"

rawstat() {
	pactl list sources 2>/dev/null | awk -v n="$1" '
		$0 == ("Name: " n) { in=1 }
		in && /Ports:/ { p=1 }
		in && p && /\[In\]/ { print (index($0, "not available") ? "" : "AVAIL"); exit }
	'
}

pick_raw() {
	local mic2="$micprefix.HiFi__Mic2__source"
	local mic1="$micprefix.HiFi__Mic1__source"
	local lock
	lock="$(cat "$lockfile" 2>/dev/null)"
	# A manual pick from the audio panel wins while its mic is usable;
	# otherwise follow the jack.
	if [ "$lock" = "mic2" ] && [ "$(rawstat "$mic2")" = "AVAIL" ]; then
		echo "$mic2"
		return
	fi
	if [ "$lock" = "mic1" ]; then
		echo "$mic1"
		return
	fi
	[ "$(rawstat "$mic2")" = "AVAIL" ] && { echo "$mic2"; return; }
	echo "$mic1"
}

for _ in $(seq 1 60); do
	pw-link -o 2>/dev/null | grep -q '^capture.noise_gate:' && break
	sleep 1
done

while true; do
	target="$(pick_raw)"
	current="$(
		pw-link -l 2>/dev/null |
			sed -n "s/^'\([^']*\)' -> 'capture.noise_gate:playback_FL'$/\1/p" |
			head -1
	)"
	current="${current%:capture_FL}"
	if [ "$current" != "$target" ]; then
		pw-link -d "$gate_in" 2>/dev/null || true
		pw-link "$target:capture_FL" "$gate_in" 2>/dev/null || true
	fi
	case "$(pactl get-default-source 2>/dev/null)" in
		"$micprefix".HiFi__Mic* ) pactl set-default-source "$gate_out" 2>/dev/null || true ;;
		"$gate_out"|"$gate_out.monitor" ) : ;;
		* ) : ;;
	esac
	sleep 2
done