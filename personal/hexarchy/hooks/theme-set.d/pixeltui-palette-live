#!/bin/bash

# Recolor running pixeltui instances the moment the Hexarchy theme changes.
#
# pixeltui's "system" theme reads the palette hexarchy just rewrote
# ($XDG_STATE_HOME/hexarchy/current/theme/colors.toml) and already polls it
# once a second, so this hook is not what makes theming work -- it only
# removes the poll delay. SIGUSR1 tells pixeltui to re-read immediately; the
# UI recolors in place, without a restart or a gap in playback.
#
# Instances on a preset theme ignore the signal.

# theme-set hooks must stay fast: signal and get out.
for pid in $(pgrep -x pixeltui 2>/dev/null); do
    kill -USR1 "$pid" 2>/dev/null || true
done

exit 0
