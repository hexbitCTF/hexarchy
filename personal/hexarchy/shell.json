        {
          "id": "hexarchy.workspaces"
        },
        {
          "id": "crmne.hyprmoncfg"
        }
      ],
      "right": [
        {
          "id": "hexarchy.tray"
        },
        {
          "id": "hexarchy.tailscale"
        },
        {
          "id": "hexarchy.agents"
        },
        {
          "id": "hexarchy.bluetooth"
        },
        {
          "id": "hexarchy.network"
        },
        {
          "id": "hexbit.audio"
        },
        {
          "id": "hexbit.monitor"
        },
        {
          "id": "hexarchy.power"
        }
      ]
    },
    "position": "top",
